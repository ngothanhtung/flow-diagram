# Loaded by `npm run dev:emulator` (scripts/dev-emulator.mjs). Values set here
# land in process.env before `next dev` starts, and Next never lets a .env
# file override process.env — so these win over .env.local and the dev
# server can only ever talk to the local emulators.
#
# `demo-*` project ids are special: the Firebase CLI and SDKs treat them as
# emulator-only and never reach a real project. Must match the
# `--project` the `emulators` script starts with.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-x-flow-tool
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-x-flow-tool.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-x-flow-tool.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
