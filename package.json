{
  "name": "flowgram-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "emulators": "firebase emulators:start --project demo-x-flow-tool --import=./.emulator-data --export-on-exit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-x-flow-tool \"vitest run --config vitest.rules.config.mts\""
  },
  "dependencies": {
