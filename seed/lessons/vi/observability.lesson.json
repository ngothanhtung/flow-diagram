  "steps": [
    {
      "id": "s1",
      "short": "Nó chậm",
      "title": "“Thanh toán chậm.” Chậm ở đâu?",
      "chapter": "problem",
      "body": "Ticket hỗ trợ chất đống: thanh toán mất vài giây. Một lần thanh toán đi qua gateway, đơn hàng, kho, thanh toán, một cơ sở dữ liệu và một API chống gian lận của bên thứ ba.\n\nBạn thấy một yêu cầu đang chờ ở đâu đó trong sơ đồ này, nhưng nhóm thì không. CPU của mọi máy chủ trông đều ổn, và không ai biết nên bắt đầu từ đâu.",
      "callout": {
        "kind": "warning",
        "text": "Nếu người dùng phát hiện sự cố trước bạn, bạn đang bay mù."
      },
      "changes": [],
      "metrics": {
        "detect": "2 giờ (ticket hỗ trợ)",
        "p99": "2,4 s",
        "signals": "không có"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Metric",
      "title": "Metric: những con số theo thời gian",
      "chapter": "technique",
      "body": "Mỗi dịch vụ ghi lại vài con số về các yêu cầu nó xử lý (phương pháp [[RED]]: **R**ate, tức số yêu cầu/giây; **E**rrors, tỷ lệ lỗi; **D**uration, các phân vị độ trễ) rồi gửi về một kho chuỗi thời gian có dashboard.\n\nGiờ bức tranh đã rõ: kho và cơ sở dữ liệu đều nhanh; sự chậm nằm trên đường thanh toán.",
      "callout": {
        "kind": "tip",
        "text": "Bộ công cụ phổ biến: Prometheus + Grafana, Datadog, CloudWatch. Đo p99, đừng chỉ đo trung bình. RED mô tả yêu cầu; với máy móc, hãy theo dõi **USE**: mức sử dụng, độ bão hòa, lỗi."
      },
      "changes": [
        "+ Metric RED trên mọi dịch vụ",
        "+ Dashboard: p99 theo từng dịch vụ"
      ],
      "metrics": {
        "detect": "5 phút",
        "locate": "đường thanh toán",
        "p99": "2,4 s",
        "signals": "metric"
      },
      "overrides": {
        "db": {
          "visible": false
        }
      }
    },
    {
      "id": "s3",
      "short": "Cảnh báo",
      "title": "Cảnh báo theo những gì người dùng cảm nhận",
      "chapter": "technique",
      "body": "Đừng gọi ai dậy vì “CPU trên 80%”: nó kêu liên tục và thường chẳng có ý nghĩa gì. Hãy cảnh báo theo các **triệu chứng** mà người dùng cảm nhận.\n\nChọn một [[SLI]] (chẳng hạn tỷ lệ lượt thanh toán nhanh hơn 1 s), đặt mục tiêu [[SLO]] (99,9%), và cảnh báo khi bạn đang đốt phần [[ngân sách lỗi]] còn lại quá nhanh.",
      "callout": {
        "kind": "tip",
        "text": "Ngân sách lỗi biến độ tin cậy thành một con số chung: khi còn, hãy ra mắt tính năng; khi hết, hãy sửa độ tin cậy trước."
      },
      "changes": [
        "+ SLO: 99,9% lượt thanh toán dưới 1 s",
        "+ Cảnh báo khi ngân sách lỗi bị đốt"
      ],
      "metrics": {
        "detect": "2 phút",
        "locate": "đường thanh toán",
        "p99": "2,4 s",
        "signals": "metric + cảnh báo"
      },
      "overrides": {
        "db": {
          "visible": false
        }
      }
    },
    {
      "id": "s4",
      "short": "Log",
      "title": "Log: câu chuyện, từng dòng một",
      "chapter": "technique",
      "body": "Metric cho biết *ở đâu*; [[log]] cho biết *chuyện gì đã xảy ra*. Mỗi dịch vụ ghi các sự kiện có dấu thời gian, nhưng với hàng nghìn yêu cầu mỗi giây, các dòng của những yêu cầu khác nhau đan xen thành nhiễu.\n\nMẹo là: gán cho mỗi yêu cầu một id tại gateway, truyền nó đi tiếp và đưa nó vào mọi dòng log. Lọc theo một id, bạn có câu chuyện của một yêu cầu.",
      "callout": {
        "kind": "tip",
        "text": "Hãy ghi log dạng JSON có cấu trúc, không phải văn bản tự do, để bạn có thể lọc theo id yêu cầu, người dùng, dịch vụ hoặc trạng thái."
      },
      "changes": [
        "+ Id yêu cầu trên mọi dòng log"
      ],
      "metrics": {
        "detect": "2 phút",
        "locate": "thanh toán → API chống gian lận?",
        "p99": "2,4 s",
        "signals": "metric + log"
      },
      "overrides": {
        "db": {
          "visible": false
        }
      }
    },
    {
      "id": "s5",
      "short": "Trace",
      "title": "Trace: theo một yêu cầu đi khắp nơi",
      "chapter": "solution",
      "body": "Một [[trace phân tán]] ghi lại mỗi chặng của một yêu cầu thành một **span** có thời điểm bắt đầu và thời lượng, tất cả được nối với nhau bằng cùng một trace id. Vẽ dưới dạng thác nước, nó cho thấy chính xác thời gian đi đâu.\n\nTheo dõi yêu cầu màu tím: 2,1 trong 2,4 giây của nó là để chờ API chống gian lận của bên thứ ba.",
      "callout": {
        "kind": "insight",
        "text": "Công cụ: OpenTelemetry để thu thập; Jaeger, Tempo, Honeycomb hoặc Datadog để khám phá. Gắn đo đạc một lần, dùng ở mọi nơi."
      },
      "changes": [
        "+ Trace id được truyền qua các dịch vụ",
        "~ Đã tìm ra nguyên nhân: API chống gian lận ≈ 88% thời gian"
      ],
