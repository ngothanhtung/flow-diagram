  "steps": [
    {
      "id": "s1",
      "short": "Vấn đề",
      "title": "hash % N hỏng khi N thay đổi",
      "chapter": "problem",
      "body": "Bài trước kết thúc không vui: với `shard = hash(key) % N`, đi từ 4 lên 5 shard làm đổi kết quả cho khoảng 80% số khóa. Gần như mọi dữ liệu phải dời.\n\nTa muốn một cách mà khi thêm máy chủ chỉ dời những khóa máy đó cần tiếp nhận: khoảng 1/N trong số đó.",
      "callout": {
        "kind": "insight",
        "text": "Mẹo là thôi hẳn việc buộc vị trí vào N."
      },
      "changes": [],
      "metrics": {
        "nodes": "4",
        "moved": "80%",
        "maxShare": "25%"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Vòng",
      "title": "Uốn không gian hash thành một vòng",
      "chapter": "technique",
      "body": "Giá trị hash chạy từ 0 đến 2³². Nối hai đầu lại và bạn có một [[vòng]].\n\nGiờ băm cả tên của từng **máy chủ** và đặt nó lên vòng ở điểm đó. Các máy chủ trượt tới bất cứ đâu hash đặt chúng: không cách đều, chỉ là nơi hash rơi vào.",
      "callout": {
        "kind": "tip",
        "text": "Không gì ở đây phụ thuộc vào số máy chủ. Đó chính là cốt lõi."
      },
      "changes": [
        "+ Vòng hash",
        "~ Máy chủ đặt tại hash(tên máy chủ)"
      ],
      "metrics": {
        "nodes": "4"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Khóa",
      "title": "Mỗi khóa đi theo chiều kim đồng hồ",
      "chapter": "technique",
      "body": "Băm cả từng **khóa** lên vòng. Một khóa thuộc về **máy chủ đầu tiên theo chiều kim đồng hồ** tính từ nó. Các cung màu cho thấy máy chủ nào sở hữu đoạn nào; mỗi chấm là một khóa, tô màu theo chủ của nó.\n\nXem một lượt tra cứu đi theo chiều kim đồng hồ từ một khóa tới máy chủ của nó.",
      "callout": {
        "kind": "insight",
        "text": "Để tìm máy chủ của một khóa: băm khóa, đi theo chiều kim đồng hồ, dừng ở máy chủ đầu tiên. Client làm việc này bằng một danh sách đã sắp xếp và tìm kiếm nhị phân."
      },
      "changes": [
        "+ Khóa trên vòng",
        "~ Mỗi khóa thuộc máy chủ kế tiếp theo chiều kim đồng hồ"
      ],
      "metrics": {
        "nodes": "4",
        "maxShare": "28%"
      },
      "overrides": {}
    },
    {
      "id": "s4",
      "short": "Thêm máy chủ",
      "title": "Thêm một máy chủ chỉ dời một cung",
      "chapter": "solution",
      "body": "Máy chủ E tham gia tại vị trí hash của nó, giữa C và B. Nó chỉ tiếp nhận các khóa trong cung ngay trước nó theo chiều ngược kim đồng hồ: những khóa trước đây đi ngang qua nó để tới C.\n\nMọi khóa khác ở yên đúng chỗ cũ. Các khóa đang nhấp nháy là những khóa duy nhất phải dời.",
      "callout": {
        "kind": "tip",
        "text": "Thêm máy chủ thứ 5 dời khoảng 1/5 số khóa: mức tối thiểu có thể."
      },
      "changes": [
        "+ Máy chủ E",
        "~ 3 trong 18 khóa dời đi (sang E)",
        "~ Mọi thứ khác giữ nguyên"
      ],
      "metrics": {
        "nodes": "5",
        "moved": "17%",
        "maxShare": "28%"
      },
      "overrides": {
        "ring-key-322": {
          "visible": false
        },
        "ring-key-336": {
          "visible": false
