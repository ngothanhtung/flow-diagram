  "steps": [
    {
      "id": "s1",
      "short": "Đã đăng nhập",
      "title": "Alice đăng nhập",
      "chapter": "setup",
      "body": "Alice đăng nhập và thêm hai món vào giỏ hàng. Yêu cầu của cô tình cờ rơi vào Server A, nơi giữ một [[phiên]] trong bộ nhớ: cô là ai và trong giỏ có gì.\n\nTrình duyệt của cô giữ một cookie chứa id phiên, để các yêu cầu sau tìm lại được phiên đó.",
      "callout": {
        "kind": "insight",
        "text": "**Trạng thái** là bất cứ thứ gì server ghi nhớ giữa các yêu cầu: đăng nhập, giỏ hàng, tệp tải lên dở dang."
      },
      "changes": [],
      "metrics": {
        "ok": "1 / 1",
        "extra": "+0 ms"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Đã đăng xuất",
      "title": "Yêu cầu tiếp theo rơi vào chỗ khác",
      "chapter": "problem",
      "body": "Bộ cân bằng tải đang làm đúng việc: round robin gửi các yêu cầu tiếp theo của Alice tới B rồi tới C. Cả hai chưa từng nghe về cô.\n\nVới Alice, ứng dụng bị hỏng: trang này hiện giỏ hàng, trang sau lại bắt cô đăng nhập lại.",
      "callout": {
        "kind": "warning",
        "text": "Nếu một server giữ trạng thái trong bộ nhớ, mọi server khác đều vô dụng với người dùng đó."
      },
      "changes": [
        "~ Yêu cầu 2 và 3 tới B và C",
        "- “Vui lòng đăng nhập lại”"
      ],
      "metrics": {
        "ok": "1 / 3",
        "survive": "không",
        "scale": "không",
        "extra": "+0 ms"
      },
      "overrides": {
