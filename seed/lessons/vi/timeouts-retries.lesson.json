  "steps": [
    {
      "id": "s1",
      "short": "Lệnh gọi chậm",
      "title": "Một dịch vụ chậm kéo sập dịch vụ khác",
      "chapter": "problem",
      "body": "Dịch vụ thanh toán bắt đầu trả lời sau 30 giây thay vì 50 ms. Dịch vụ đơn hàng gọi nó và cứ thế **chờ**, không giới hạn.\n\nMỗi lệnh gọi đang chờ giữ một thread. Trong vòng một phút, cả 200 đều kẹt, và dịch vụ đơn hàng không phục vụ nổi cả những trang không cần thanh toán. Một phụ thuộc chậm đã thành sự cố toàn phần.",
      "callout": {
        "kind": "warning",
        "text": "Đây là sự cố dây chuyền: rắc rối lan ngược lên qua mọi thứ chờ mà không có giới hạn."
      },
      "changes": [],
      "metrics": {
        "success": "40%",
        "p99": "30,0 s",
        "payLoad": "1×",
        "threads": "200 / 200 bận"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Timeout",
      "title": "Đặt timeout, có phương án dự phòng",
      "chapter": "solution",
      "body": "Đặt cho mọi lệnh gọi ra ngoài một [[timeout]]: nếu thanh toán chưa trả lời trong 800 ms, bỏ cuộc và giải phóng thread.\n\nRồi xuống cấp một cách êm ái: nhận đơn ở trạng thái “chờ thanh toán” và trừ tiền ngay sau đó. Dịch vụ đơn hàng vẫn chạy cho mọi việc khác.",
      "callout": {
        "kind": "tip",
        "text": "Đặt timeout theo độ trễ thực tế: cao hơn p99 của phụ thuộc một chút, và luôn ngắn hơn timeout của chính bên gọi bạn."
      },
      "changes": [
        "+ Timeout 800 ms cho lệnh gọi thanh toán",
        "+ Dự phòng: “chờ thanh toán”",
        "~ Thread bận 200 → 35"
      ],
      "metrics": {
        "success": "72%",
        "p99": "820 ms",
        "payLoad": "1×",
        "threads": "35 / 200 bận"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Thử lại",
      "title": "Thử lại những trục trặc thoáng qua",
      "chapter": "technique",
      "body": "Nhiều lỗi chỉ thoáng qua: một gói tin bị rơi, một máy chủ đang khởi động lại, một trục trặc ngắn. Thử lại sau giây lát thường thành công.\n\nMột lần thử lại (màu hổ phách) biến hầu hết các lỗi đó thành thành công.",
      "callout": {
        "kind": "tip",
        "text": "Chỉ thử lại những lỗi có thể thành công lần sau: timeout, 503. Thử lại một 400 Bad Request thì chỉ thất bại tiếp."
      },
      "changes": [
        "+ Thử lại một lần với timeout và 503",
        "~ Thanh toán thành công 72% → 97%"
      ],
      "metrics": {
        "success": "97%",
        "p99": "950 ms",
        "payLoad": "1,1×",
        "threads": "38 / 200 bận"
      },
      "overrides": {}
    },
    {
      "id": "s4",
      "short": "Bão thử lại",
      "title": "Thử lại biến thành bão",
      "chapter": "problem",
      "body": "Rồi thanh toán thật sự quá tải. Mọi bên gọi đều thử lại, ba lần, ngay lập tức. Mỗi yêu cầu thất bại thành bốn, nên dịch vụ đang khó khăn giờ nhận **4×** tải bình thường.\n\nNó không bao giờ hồi phục được: chính các lần thử lại giữ nó nằm sập. Client của bạn đã biến thành một cuộc tấn công từ chối dịch vụ.",
      "callout": {
        "kind": "warning",
        "text": "Thử lại cũng nhân lên qua các tầng: 3 lần thử lại ở mỗi tầng trong 3 tầng là tới 64 lệnh gọi cho một cú nhấp."
      },
      "changes": [
        "~ Thanh toán quá tải",
        "~ 3 lần thử lại ngay cho mỗi lỗi",
        "~ Tải lên thanh toán 1× → 4×"
      ],
      "metrics": {
        "success": "18%",
        "p99": "2,4 s",
        "payLoad": "4×",
        "threads": "200 / 200 bận"
      },
      "overrides": {
        "pay-3": {
          "visible": false
        }
      }
    },
    {
      "id": "s5",
      "short": "Backoff",
      "title": "Lùi lại, kèm jitter",
      "chapter": "solution",
      "body": "Chờ trước khi thử lại, và mỗi lần chờ lâu hơn: 100 ms, rồi 200, rồi 400: [[exponential backoff]]. Thêm yếu tố ngẫu nhiên ([[jitter]]) để hàng nghìn client không thử lại cùng một khoảnh khắc.\n\nGiới hạn số lần thử, và giới hạn tỷ lệ lưu lượng có thể là thử lại (ngân sách thử lại ~10%). Thanh toán có khoảng trống để hồi phục.",
      "callout": {
        "kind": "tip",
        "text": "Hầu hết SDK đám mây đã làm exponential backoff có jitter: kiểm tra rằng nó đang bật, và các tầng không chồng chất các lần thử lại."
      },
      "changes": [
        "~ Thử lại chờ 100 → 200 → 400 ms (+ jitter)",
        "+ Ngân sách thử lại: 10%",
        "~ Tải lên thanh toán 4× → 1,2×"
      ],
      "metrics": {
        "success": "96%",
        "p99": "1,3 s",
        "payLoad": "1,2×",
        "threads": "45 / 200 bận"
      },
      "overrides": {
        "pay-3": {
          "visible": false
        }
      }
    },
    {
      "id": "s6",
      "short": "Cầu dao",
      "title": "Circuit breaker: tạm ngừng gọi một lúc",
      "chapter": "technique",
      "body": "Thanh toán sập hẳn. Dù có timeout, mỗi lệnh gọi vẫn phí 800 ms để phát hiện ra điều đó. Một [[circuit breaker]] (cầu dao) theo dõi lỗi: vượt một ngưỡng, nó **mở** và cho lệnh gọi thất bại ngay lập tức, không cần thử.\n\nCứ 30 giây nó cho một lệnh gọi thử đi qua (**nửa mở**, tín hiệu xanh). Nếu thành công, nó đóng lại.",
      "callout": {
        "kind": "insight",
        "text": "Giống cầu dao trong nhà bạn: nó nhảy để bảo vệ phần còn lại của hệ thống, và bạn bật lại khi lỗi đã được sửa."
      },
      "changes": [
        "- Thanh toán sập",
        "+ Circuit breaker: MỞ",
        "~ Lệnh gọi lỗi mất 1 ms, không phải 800 ms"
      ],
      "metrics": {
        "success": "88%",
        "p99": "25 ms",
        "payLoad": "nghỉ ngơi",
        "threads": "6 / 200 bận"
      },
      "overrides": {
        "pay-3": {
          "visible": false
        }
      }
    },
    {
      "id": "s7",
      "short": "Đóng",
      "title": "Nửa mở, rồi đóng",
      "chapter": "solution",
      "body": "Thanh toán hồi phục. Lệnh gọi thử kế tiếp thành công, nên cầu dao đóng và lưu lượng chảy lại, từ từ, để dịch vụ không bị dồn ngập ngay khi vừa trở lại.\n\nTrong lúc đó, các đơn “chờ thanh toán” được trừ tiền từ một hàng đợi. Không đơn nào bị mất, và phần còn lại của trang chưa từng sập.",
      "callout": {
        "kind": "tip",
        "text": "Các thư viện như resilience4j và Polly, và service mesh như Envoy/Istio, cung cấp sẵn timeout, thử lại và cầu dao."
      },
      "changes": [
        "+ Thanh toán đã hồi phục",
        "~ Cầu dao NỬA MỞ → ĐÓNG",
        "~ Đơn đang chờ đã được trừ tiền"
      ],
      "metrics": {
        "success": "99%",
        "p99": "180 ms",
        "payLoad": "1×",
        "threads": "30 / 200 bận"
      },
      "overrides": {
        "pay-3": {
          "emphasis": true
        }
      }
    },
    {
      "id": "s8",
      "short": "Idempotency",
      "title": "Thử lại không được trừ tiền hai lần",
      "chapter": "technique",
      "body": "Một trường hợp hiểm: thanh toán đã trừ tiền thẻ, nhưng phản hồi bị mất trên đường về. Dịch vụ đơn hàng bị timeout và thử lại, và khách hàng bị trừ tiền **hai lần**.\n\nCách sửa: gửi một [[khóa idempotency]] (một id duy nhất cho mỗi đơn) kèm mỗi lần thử. Thanh toán ghi nhớ kết quả của từng khóa và trả lại kết quả đó cho các bản trùng, thay vì trừ tiền lần nữa.",
      "callout": {
        "kind": "insight",
        "text": "Mọi thao tác có thể được thử lại đều phải idempotent: làm hai lần có tác dụng như làm một lần."
      },
      "changes": [
        "+ Idempotency-Key trên lệnh gọi thanh toán",
        "~ Lần thử trùng trả về kết quả đã lưu"
      ],
      "metrics": {
        "success": "99%",
        "p99": "180 ms",
        "payLoad": "1×",
        "threads": "30 / 200 bận"
      },
      "overrides": {
        "ob-2": {
          "effect": "ants"
        },
        "pay-3": {
          "visible": false
        },
        "bp-2": {
          "visible": false
        }
      }
    },
    {
      "id": "s9",
      "short": "Deadline",
      "title": "Chuyển tiếp deadline",
      "chapter": "technique",
      "body": "Trình duyệt của người mua bỏ cuộc sau 2 giây. Nhưng nếu dịch vụ đơn hàng đã tiêu 1,8 s, thì thanh toán bắt đầu thêm 800 ms việc mới là vô ích: chẳng ai thấy câu trả lời.\n\nVì vậy mỗi yêu cầu mang theo một [[deadline]]: “trả lời trước 12:00:02.000”. Mỗi dịch vụ kiểm tra thời gian còn lại và chuyển tiếp phần ngân sách còn lại; nếu đã hết, nó dừng ngay.",
      "callout": {
        "kind": "tip",
        "text": "gRPC tự động truyền deadline. Với HTTP, hãy truyền thời gian còn lại trong một header."
      },
      "changes": [
        "+ Deadline đi kèm mỗi yêu cầu",
        "~ Không bắt đầu việc nào không kịp xong"
      ],
      "metrics": {
        "success": "99%",
        "p99": "180 ms",
        "payLoad": "1×",
        "threads": "28 / 200 bận"
      },
      "overrides": {
