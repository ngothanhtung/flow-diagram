  "steps": [
    {
      "id": "s1",
      "short": "Mất kiểm soát",
      "title": "Một script, mọi người cùng khổ",
      "chapter": "problem",
      "body": "Script của một khách hàng có bug: nó gọi API của bạn trong một vòng lặp chặt, 5.000 yêu cầu mỗi giây. Máy chủ API dành gần hết thời gian cho nó.\n\nYêu cầu của người dùng thật phải xếp hàng sau cơn lũ và bị quá thời gian. Không ai tấn công bạn; một client chỉ đơn giản lấy nhiều hơn phần của mình.",
      "callout": {
        "kind": "warning",
        "text": "Năng lực dùng chung cần một quy tắc công bằng. Không có nó, client ồn ào nhất sẽ thắng."
      },
      "changes": [],
      "metrics": {
        "abuser": "5.000 yc/s",
        "served": "61%",
        "apiCpu": "99%",
        "limited": "0/s"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Giới hạn",
      "title": "Bộ giới hạn tốc độ ở cửa trước",
      "chapter": "solution",
      "body": "Đặt một [[bộ giới hạn tốc độ]] (rate limiter) trong gateway đứng trước API. Mỗi client, nhận diện theo API key, id người dùng hoặc địa chỉ IP, được một hạn mức, chẳng hạn 10 yêu cầu mỗi giây.\n\nYêu cầu trong hạn mức được cho qua. Phần còn lại bị từ chối ngay với `429 Too Many Requests`, trước khi tốn bất cứ gì của API.",
      "callout": {
        "kind": "tip",
        "text": "Từ chối sớm thì rẻ: gateway trả lời trong vài micro giây, và API không bao giờ thấy phần vượt mức."
      },
      "changes": [
        "+ Gateway có bộ giới hạn tốc độ",
        "~ Script bị giới hạn ở 10 req/s",
        "~ CPU của API 99% → 45%"
      ],
      "metrics": {
        "abuser": "5.000 yc/s",
        "served": "99%",
        "apiCpu": "45%",
        "limited": "4.990/s"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Token bucket",
      "title": "Cách nó đếm: token bucket",
      "chapter": "technique",
      "body": "Thuật toán phổ biến nhất là [[token bucket]] (thùng token). Mỗi client có một thùng chứa tối đa 10 token, được nạp lại 10 cái mỗi giây. Mỗi yêu cầu lấy một token; thùng rỗng nghĩa là 429.\n\nThùng của người dùng thật hầu như luôn đầy (các chấm xanh). Script làm rỗng thùng của nó ngay lập tức và thùng cứ thế rỗng.",
      "callout": {
        "kind": "insight",
        "text": "Kích thước thùng cho phép các đợt bùng ngắn; tốc độ nạp lại giới hạn mức trung bình dài hạn. Hai con số, dễ giải thích."
      },
      "changes": [
        "+ Mỗi client một thùng"
      ],
      "metrics": {
        "abuser": "5.000 yc/s",
        "served": "99%",
        "apiCpu": "45%",
        "limited": "4.990/s"
      },
      "overrides": {}
    },
    {
      "id": "s4",
      "short": "Thuật toán",
      "title": "Cửa sổ hay thùng",
      "chapter": "technique",
      "body": "**Cửa sổ cố định** đơn giản hơn đếm yêu cầu theo từng phút trên đồng hồ và đặt lại vào giây :00. Dễ làm, nhưng một client có thể gửi hạn mức cả phút vào 12:00:59 rồi lại gửi vào 12:01:00: gấp đôi giới hạn trong hai giây.\n\n**Cửa sổ trượt** làm mượt mép đó; **token bucket** cho phép các đợt bùng có kiểm soát. Hầu hết API gateway dùng một trong hai cách sau.",
      "callout": {
        "kind": "tip",
        "text": "Cần dòng ra đều đặn (ví dụ tới API mong manh của đối tác)? Leaky bucket xếp hàng yêu cầu và thả chúng ra theo nhịp cố định."
      },
      "changes": [],
      "metrics": {
        "abuser": "5.000 yc/s",
        "served": "99%",
        "apiCpu": "45%",
        "limited": "4.990/s"
      },
      "overrides": {}
    },
    {
      "id": "s5",
      "short": "Nhiều gateway",
      "title": "Nhiều gateway, một hạn mức",
      "chapter": "problem",
      "body": "Một gateway là không đủ, nên bạn chạy nhiều cái sau bộ cân bằng tải. Nếu mỗi cái tự đếm riêng, một client rải trên 10 gateway sẽ được gấp 10 lần giới hạn.\n\nVì vậy các gateway giữ bộ đếm trong một kho chung, nhanh (thường là Redis): mỗi yêu cầu tăng nguyên tử bộ đếm và kiểm tra tổng.",
      "callout": {
        "kind": "tip",
        "text": "Kho chung thêm ~1 ms mỗi yêu cầu. Một số hệ thống đánh đổi chút độ chính xác lấy tốc độ bằng cách đồng bộ bộ đếm cục bộ mỗi giây."
      },
      "changes": [
        "+ Gateway thứ hai",
        "+ Kho bộ đếm dùng chung",
        "- Thùng của mỗi client giờ nằm trong kho"
      ],
      "metrics": {
        "abuser": "5.000 yc/s",
        "served": "99%",
        "apiCpu": "45%",
        "limited": "4.990/s"
      },
      "overrides": {}
    },
    {
      "id": "s6",
      "short": "Lùi lại",
      "title": "Hướng dẫn client cách cư xử",
      "chapter": "technique",
      "body": "Một phản hồi 429 tốt cho biết khi nào quay lại: header `Retry-After: 30`, cùng các header cho thấy giới hạn và phần còn lại. Client tử tế sẽ chậm lại và thử lại sau.\n\nChủ của script sửa vòng lặp. Giờ nó dùng đúng phần công bằng của mình, không hơn.",
      "callout": {
        "kind": "tip",
        "text": "Công bố giới hạn trong tài liệu API, và cung cấp gói cao hơn cho khách hàng thực sự cần nhiều hơn."
      },
      "changes": [
        "+ Header Retry-After và RateLimit",
        "~ Script lùi về 10 req/s"
      ],
      "metrics": {
        "abuser": "10 yc/s",
        "served": "100%",
        "apiCpu": "38%",
        "limited": "0/s"
      },
      "overrides": {
        "gw2": {
          "visible": false
        },
        "ga2": {
          "visible": false
        },
        "g2r": {
          "visible": false
        }
      }
    },
    {
      "id": "s7",
      "short": "Tenant",
      "title": "Tình huống: 10.000 người dùng của một khách hàng",
      "chapter": "problem",
      "body": "Bạn bán API cho các công ty. Một khách hàng chạy việc nhập dữ liệu mỗi đêm với 10.000 người dùng tử tế, ai cũng dưới giới hạn cá nhân, nhưng cộng lại dùng 70% năng lực của bạn. Các khách hàng khác bị chậm mỗi đêm.\n\nGiới hạn theo người dùng không thấy được điều này. Thêm giới hạn theo **tenant** (tài khoản khách hàng), tính theo gói của họ, chồng lên giới hạn theo người dùng.",
      "callout": {
        "kind": "tip",
        "text": "Xếp lớp giới hạn: theo người dùng, theo tenant, theo endpoint (endpoint tốn kém có giới hạn thấp hơn), và một trần toàn cục."
      },
      "changes": [
        "+ Hạn ngạch theo tenant (theo gói)",
        "~ Đợt nhập lớn bị giới hạn theo phần của gói"
      ],
      "metrics": {
        "served": "99%",
        "apiCpu": "55%",
        "limited": "1.200/s"
      },
