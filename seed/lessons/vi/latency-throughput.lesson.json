  "steps": [
    {
      "id": "s1",
      "short": "Hai con số",
      "title": "Hai câu hỏi khác nhau",
      "chapter": "setup",
      "body": "[[Độ trễ]] (latency): *một* yêu cầu mất bao lâu, từ lúc rời người dùng đến khi câu trả lời quay về? Hãy xem một chấm đi rồi về.\n\n[[Thông lượng]] (throughput): hệ thống hoàn thành bao nhiêu yêu cầu *mỗi giây*? Hãy đếm các chấm.",
      "callout": {
        "kind": "insight",
        "text": "Hãy nghĩ tới đường cao tốc: độ trễ là chuyến đi của bạn mất bao lâu; thông lượng là bao nhiêu xe qua mỗi giờ. Thêm làn cho nhiều xe qua hơn, nhưng trên đường vắng chúng không giúp bạn tới sớm hơn."
      },
      "changes": [],
      "metrics": {
        "p50": "120 ms",
        "p99": "180 ms",
        "throughput": "50 yc/s",
        "util": "10%"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Bận hơn",
      "title": "Nhiều người dùng hơn, cùng server",
      "chapter": "problem",
      "body": "Lưu lượng tăng 7 lần. Thông lượng tăng theo (server vẫn theo kịp) và giờ nó bận 70%: 350 trên khoảng 500 yc/s mà nó xử lý được.\n\nNhưng hãy nhìn hàng phía trước nó: thỉnh thoảng các yêu cầu phải **chờ đến lượt**. Chờ cũng là độ trễ.",
      "callout": {
        "kind": "tip",
        "text": "Mức sử dụng = phần thời gian server bận. Ở 70%, một yêu cầu mới thường gặp nó đang làm việc khác."
      },
      "changes": [
        "~ Người dùng 1.000 → 7.000",
        "~ Thông lượng 50 → 350 yc/s",
        "+ Một hàng đợi ngắn hình thành"
      ],
      "metrics": {
        "p50": "160 ms",
        "p99": "600 ms",
        "throughput": "350 yc/s",
        "util": "70%"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Gậy khúc côn cầu",
      "title": "Cây gậy khúc côn cầu",
      "chapter": "problem",
      "body": "Lưu lượng tăng thêm một phần ba và server lên 96% bận. Thông lượng chỉ tăng tới 480 yc/s, sát trần 500 của nó, nhưng hàng đợi bùng nổ và độ trễ tăng **gấp bảy**.\n\nYêu cầu không đến cách đều nhau. Còn dư 30% thì một đợt dồn được hấp thụ nhanh; còn 4% thì mỗi đợt chồng lên sau những yêu cầu đang chờ, và hàng phải rất lâu mới vơi.",
      "callout": {
        "kind": "warning",
        "text": "Độ trễ tăng chậm, rồi đột ngột. Hãy lên kế hoạch chạy khoảng 60–70% bận lúc cao điểm và giữ phần còn lại làm dư địa."
      },
      "changes": [
        "~ Người dùng 7.000 → 9.600",
        "~ Mức sử dụng 70% → 96%",
        "~ Hàng đợi 2 → 6 đang chờ",
        "~ Độ trễ p99 600 ms → 4,2 s",
        "~ Thông lượng 350 → 480 yc/s"
      ],
      "metrics": {
        "p50": "900 ms",
        "p99": "4,2 s",
        "throughput": "480 yc/s",
        "util": "96%"
      },
      "overrides": {
        "users-2": {
          "visible": false
        },
        "srv-2": {
          "visible": false
        },
        "q": {
          "visible": false
        },
        "u-2": {
          "visible": false
        }
      }
    },
    {
      "id": "s4",
      "short": "Trung bình đánh lừa",
      "title": "Trung bình che giấu nỗi đau",
      "chapter": "insight",
      "body": "Quay về 70% bận, phần lớn yêu cầu nhanh, nhưng vài cái bị kẹt sau việc chậm. *Trung bình* ở đây khoảng 180 ms, trông có vẻ ổn: nó hòa tan vài yêu cầu chậm.\n\nVì vậy ta đo [[phân vị]]: **p50** là thời gian mà một nửa yêu cầu nhanh hơn; **p99** là thời gian mà chỉ 1 trên 100 vượt quá.",
      "callout": {
        "kind": "warning",
        "text": "Một trang gửi 30 yêu cầu sẽ dính p99 khoảng 1 trong 4 lần tải (1 − 0,99³⁰ ≈ 26%). Độ trễ đuôi mới là thứ người dùng thật sự cảm nhận."
      },
      "changes": [
        "~ Trở lại 7.000 người dùng",
        "+ Thỉnh thoảng có yêu cầu chậm (màu hổ phách)",
        "~ Độ trễ p99 4,2 s → 600 ms"
      ],
      "metrics": {
        "p50": "160 ms",
        "p99": "600 ms",
        "throughput": "350 yc/s",
        "util": "70%"
      },
      "overrides": {
        "u-2": {
          "effect": "ants",
          "emphasis": true
        },
        "users-2": {
          "emphasis": true
        },
        "srv-2": {
          "emphasis": true
        },
        "q": {
          "emphasis": true
        }
      }
    },
    {
      "id": "s5",
      "short": "Thêm năng lực",
      "title": "Thêm năng lực, lấy lại độ trễ",
      "chapter": "solution",
      "body": "Nhân đôi số core của server và cùng 350 yc/s giờ chỉ còn 35% năng lực. Hàng đợi vơi đi, cả p50 lẫn p99 đều giảm.\n\nThông lượng không đổi: nhu cầu không đổi. Điều thay đổi là **còn bao nhiêu dư địa** để hấp thụ các đợt dồn.",
      "callout": {
        "kind": "tip",
        "text": "Muốn giảm độ trễ khi tải cao, hãy giảm mức sử dụng: thêm năng lực, hoặc bớt việc cho mỗi yêu cầu."
      },
      "changes": [
        "~ Server 4 → 8 core",
        "~ Mức sử dụng 70% → 35%",
        "- Hết hàng đợi",
        "~ Độ trễ p99 600 → 190 ms"
      ],
      "metrics": {
        "p50": "120 ms",
        "p99": "190 ms",
        "throughput": "350 yc/s",
        "util": "35%"
      },
      "overrides": {}
    },
    {
      "id": "s6",
      "short": "Khoảng cách",
      "title": "Khoảng cách cũng là độ trễ",
      "chapter": "insight",
      "body": "Giờ hãy chuyển server sang bờ bên kia đại dương. Nó không chậm đi chút nào, vậy mà mỗi lượt khứ hồi lâu hơn: hãy xem các chấm di chuyển.\n\nÁnh sáng trong cáp quang đi khoảng 200 km mỗi mili giây. New York ↔ London ~5.600 km: ít nhất 56 ms mỗi lượt khứ hồi, thực tế gần 75 ms.",
      "callout": {
        "kind": "insight",
        "text": "Không nâng cấp server nào thắng được vật lý. Muốn giảm độ trễ này, hãy đưa dữ liệu lại gần người dùng (cache, CDN, vùng)."
      },
      "changes": [
        "~ Server dời đi: New York → London",
        "+ ~75 ms mỗi lượt khứ hồi",
        "~ Độ trễ p50 120 → 195 ms"
      ],
      "metrics": {
        "p50": "195 ms",
        "p99": "265 ms",
        "throughput": "350 yc/s",
        "util": "35%"
      },
