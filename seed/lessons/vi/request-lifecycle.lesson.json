  "steps": [
    {
      "id": "s1",
      "short": "Nhấn Enter",
      "title": "Người dùng than cửa hàng chậm",
      "chapter": "problem",
      "body": "Trước khi làm gì đó nhanh hơn, bạn cần biết thời gian đi đâu. Vậy hãy theo dõi một lần tải trang.\n\nBạn gõ `shop.example` và nhấn Enter. Khoảng một phần sáu giây sau trang hiện ra. Ở giữa có rất nhiều chuyện xảy ra.",
      "callout": {
        "kind": "insight",
        "text": "Mỗi yêu cầu web là một cuộc trò chuyện giữa các máy. Mỗi bước tốn thời gian, và chi phí cộng dồn lại."
      },
      "changes": [],
      "metrics": {},
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Tìm địa chỉ",
      "title": "Tìm địa chỉ (DNS)",
      "chapter": "technique",
      "body": "Mạng định tuyến theo địa chỉ IP dạng số, không theo tên. Vì vậy trình duyệt trước tiên hỏi một bộ phân giải [[DNS]]: *shop.example ở đâu?*\n\nCâu trả lời (`203.0.113.7`) quay về sau khoảng 20 ms.",
      "callout": {
        "kind": "tip",
        "text": "Câu trả lời được cache trong một thời gian sống (TTL). Trong vài phút tiếp theo, các lần ghé lại bỏ qua hẳn bước này."
      },
      "changes": [
        "+ Bộ phân giải DNS",
        "+ Tra cứu: 20 ms"
      ],
      "metrics": {
        "dns": "20 ms",
        "total": "20 ms"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Kết nối",
      "title": "Mở một kết nối",
      "chapter": "technique",
      "body": "Giờ trình duyệt mở kết nối tới `203.0.113.7`. Bắt tay TCP thống nhất cuộc nói chuyện; bắt tay TLS thiết lập mã hóa. Mỗi lần cần một [[lượt khứ hồi]] (round trip): đi và về.\n\nỞ đây một lượt khứ hồi mất 30 ms, nên kết nối tốn 60 ms trước khi một byte nào của trang được yêu cầu.",
      "callout": {
        "kind": "insight",
        "text": "Thời gian khứ hồi (RTT) do khoảng cách và mạng quyết định, không phải do server của bạn nhanh đến đâu."
      },
      "changes": [
        "+ Web server",
        "~ Câu trả lời DNS đã cache",
        "+ Bắt tay: 2 lượt khứ hồi = 60 ms"
      ],
      "metrics": {
        "dns": "20 ms",
        "connect": "60 ms",
        "total": "80 ms"
      },
      "overrides": {}
    },
    {
      "id": "s4",
      "short": "Yêu cầu",
      "title": "Gửi yêu cầu",
      "chapter": "technique",
      "body": "Qua kết nối đang mở, trình duyệt gửi `GET /products`. Server phân tích nó, kiểm tra phiên và chạy mã của bạn.\n\nViệc đó tốn thêm một lượt khứ hồi cộng ~10 ms xử lý ở server.",
      "changes": [
        "+ Yêu cầu: 1 lượt khứ hồi + 10 ms ở server"
      ],
