  "steps": [
    {
      "id": "s1",
      "short": "Một server",
      "title": "Mọi thứ bắt đầu với một server",
      "chapter": "setup",
      "body": "Ứng dụng của bạn chạy trên một máy duy nhất. Mỗi yêu cầu (mở một trang, đăng một bức ảnh) đi từ thiết bị của người dùng tới server đó rồi quay về.\n\nVới một trăm người dùng nó gần như không nhận ra: CPU nhàn rỗi quanh **1%**.",
      "callout": {
        "kind": "insight",
        "text": "Một server có ngân sách cố định về CPU, bộ nhớ, ổ đĩa và mạng. **Năng lực** của nó là số yêu cầu mỗi giây nó phục vụ được trước khi một trong số đó cạn."
      },
      "changes": [],
      "metrics": {
        "users": "100",
        "rps": "4",
        "p95": "80 ms",
        "errors": "0%",
        "cost": "150 $"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Tăng vọt viral",
      "title": "Rồi bạn lên viral",
      "chapter": "problem",
      "body": "Một bài đăng bùng nổ và lưu lượng tăng vọt **120×**. Máy này phục vụ được khoảng 400 yêu cầu mỗi giây, mà có tới 480 đang đến. CPU kẹt ở 100%, các yêu cầu xếp hàng chờ lượt, độ trễ phình to và một số bỏ cuộc vì hết thời gian chờ.\n\nBạn cần thêm năng lực. Có hai cách khác nhau về bản chất để có được nó.",
      "callout": {
        "kind": "warning",
        "text": "Quá tải trông như sau: CPU gần 100%, hàng đợi yêu cầu dài ra, độ trễ tăng, rồi timeout."
      },
      "changes": [
        "~ Người dùng 100 → 12.000",
        "~ CPU 1% → 100%",
        "+ Yêu cầu bị timeout"
      ],
      "metrics": {
        "users": "12.000",
        "rps": "480",
        "p95": "2,4 s",
        "errors": "17%",
        "cost": "150 $"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Mở rộng dọc",
      "title": "Cách 1: mở rộng theo chiều dọc",
      "chapter": "solution",
      "body": "Cách sửa đơn giản nhất: chuyển sang máy lớn hơn. Nhiều lõi hơn, nhiều bộ nhớ hơn, ổ đĩa nhanh hơn.\n\nThiết kế của bạn không đổi gì; mã thậm chí không biết. Đây là [[mở rộng theo chiều dọc]], hay *scale up*.",
      "callout": {
        "kind": "tip",
        "text": "Mở rộng dọc là bước đầu tiên tuyệt vời: không sửa mã và không có gì mới phải vận hành. Máy gấp bốn, giá cũng khoảng gấp bốn."
      },
      "changes": [
        "~ Server 4 vCPU → 16 vCPU",
        "~ CPU 100% → 30%",
        "~ Chi phí $150 → $600 / tháng"
      ],
      "metrics": {
        "users": "12.000",
        "rps": "480",
        "p95": "110 ms",
        "errors": "0%",
        "cost": "600 $"
      },
      "overrides": {}
    },
    {
      "id": "s4",
      "short": "Trần",
      "title": "…cho tới khi bạn chạm trần",
      "chapter": "tradeoff",
      "body": "Tăng trưởng tiếp tục và bạn nâng cấp hết lần này tới lần khác, nhưng máy chỉ to được tới một mức. Ngay cả server đa dụng lớn nhất cũng không theo kịp, và phần mềm hiếm khi dùng 192 lõi tốt như khi dùng 16: khóa, bộ nhớ và một ổ đĩa dùng chung cản đường.\n\nMỗi lần nâng cấp cũng là một lần di chuyển: khởi động lại, và ngừng dịch vụ trong lúc chuyển.",
      "callout": {
        "kind": "warning",
        "text": "Mở rộng dọc có một trần cứng. Trên đám mây, giá tăng gần như theo kích thước, cho tới đỉnh của dải sản phẩm, nơi những cỗ máy đặc biệt có giá cao hơn và gấp đôi số lõi không còn nghĩa là gấp đôi thông lượng."
      },
      "changes": [
        "~ Người dùng 12.000 → 500.000",
        "+ Đã tới máy lớn nhất",
        "~ Chi phí $600 → $7.200 / tháng"
      ],
      "metrics": {
        "users": "500.000",
        "rps": "20.000",
        "p95": "3,1 s",
        "errors": "12%",
        "cost": "7.200 $"
      },
      "overrides": {}
    },
    {
      "id": "s5",
      "short": "Một sự cố",
      "title": "…và nó là điểm lỗi duy nhất",
      "chapter": "problem",
      "body": "Tệ hơn, mọi thứ phụ thuộc vào một máy. Một lần triển khai lỗi, một ổ đĩa đầy hay một bộ nguồn hỏng, và toàn bộ sản phẩm ngừng hoạt động.\n\nMột thành phần mà khi hỏng sẽ kéo sập cả hệ thống được gọi là [[điểm lỗi duy nhất]] (SPOF).",
      "callout": {
        "kind": "warning",
        "text": "Dù to đến đâu, một máy luôn chỉ cách sự cố sập toàn bộ đúng một lần hỏng."
      },
      "changes": [
        "- Server ứng dụng sập",
        "~ Lỗi 12% → 100%"
      ],
      "metrics": {
        "users": "500.000",
        "rps": "20.000",
        "errors": "100%",
        "cost": "7.200 $"
      },
      "overrides": {}
    },
    {
      "id": "s6",
      "short": "Mở rộng ngang",
      "title": "Cách 2: mở rộng theo chiều ngang",
      "chapter": "solution",
      "body": "Thay vì một máy khổng lồ, chạy vài máy cỡ vừa cạnh nhau (ở đây là bốn máy, mỗi máy 96 vCPU), tất cả chạy cùng một mã.\n\nCần thêm năng lực? Thêm một server. Máy cỡ vừa đáng tiền nhất, không có trần cứng, và mỗi máy chỉ là một phần nhỏ của tổng thể. Đây là [[mở rộng theo chiều ngang]], hay *scale out*: cách mà hầu như mọi hệ thống lớn phát triển.",
      "callout": {
        "kind": "tip",
        "text": "Bốn server 96 vCPU có năng lực gấp đôi máy đơn lớn nhất, và bất kỳ máy nào cũng có thể hỏng trong khi ba máy còn lại gánh tải."
      },
      "changes": [
        "~ 1 server khổng lồ → 4 server cỡ vừa",
        "~ Năng lực × 2 · chi phí $7.200 → $14.400 / tháng",
        "~ CPU ≈ 52% mỗi máy",
        "~ Lỗi 100% → 0%"
      ],
      "metrics": {
        "users": "500.000",
        "rps": "20.000",
        "p95": "95 ms",
        "errors": "0%",
        "cost": "14.400 $"
      },
      "overrides": {}
    },
    {
      "id": "s7",
      "short": "Ban đêm",
      "title": "Năng lực đỉnh, nhàn rỗi cả đêm",
      "chapter": "problem",
      "body": "Lưu lượng đi theo đồng hồ. Lúc 8 giờ tối bạn cần cả bốn server; lúc 4 giờ sáng lưu lượng chỉ bằng một phần mười, và chúng ngồi ở 5% CPU.\n\nBạn trả tiền cho năng lực đỉnh 24 giờ mỗi ngày. Phần lớn thời gian, phần lớn số đó không làm gì cả.",
      "callout": {
        "kind": "insight",
        "text": "Ứng dụng tiêu dùng thường dao động 3–10× giữa đỉnh và đáy trong ngày."
      },
      "changes": [
        "~ 4 giờ sáng: người dùng 500.000 → 50.000",
        "~ CPU ≈ 52% → 5%"
      ],
      "metrics": {
        "users": "50.000",
        "rps": "2.000",
        "p95": "90 ms",
        "errors": "0%",
        "cost": "14.400 $"
      },
      "overrides": {
