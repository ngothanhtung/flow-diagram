  "steps": [
    {
      "id": "s1",
      "short": "Hai cấp",
      "title": "Một hệ thống, hai mức phóng to",
      "chapter": "setup",
      "body": "Một ứng dụng giao đồ ăn. Nhìn từ xa, đó là vài dịch vụ (Đơn hàng, Tài xế, Thanh toán), mỗi dịch vụ có dữ liệu riêng, nói chuyện qua một API gateway và một luồng sự kiện.\n\nNhìn gần, mỗi ô đó là một chương trình riêng, có lớp, bảng và quy tắc. Thiết kế hệ thống làm việc ở cả hai khoảng cách, và chúng có tên: [[thiết kế cấp cao]] (HLD) và [[thiết kế cấp thấp]] (LLD).",
      "callout": {
        "kind": "insight",
        "text": "Không cấp nào “thật hơn”. Chúng trả lời những câu hỏi khác nhau, cho những người đọc khác nhau, và thay đổi với tốc độ khác nhau."
      },
      "changes": [],
      "metrics": {
        "zoom": "toàn hệ thống",
        "unit": "dịch vụ · kho lưu trữ · hàng đợi",
        "output": "sơ đồ kiến trúc"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Bản đồ",
      "title": "Thiết kế cấp cao: bản đồ",
      "chapter": "technique",
      "body": "HLD quyết định **các phần là gì và chúng nối với nhau thế nào**: có những dịch vụ nào và mỗi cái sở hữu gì, chúng nói chuyện ra sao (một lời gọi hay một sự kiện), mỗi loại dữ liệu nằm ở đâu, và điều gì xảy ra khi lưu lượng tăng hay một phần hỏng.\n\nĐó là cấp độ của mọi bài học từ đầu tới giờ. Kết quả của nó là một sơ đồ như thế này, kèm lập luận viết bên cạnh.",
      "callout": {
        "kind": "tip",
        "text": "Một HLD tốt vừa trong một trang. Nếu một ô cần cả đoạn văn để giải thích, đoạn đó thuộc về LLD của ô ấy."
      },
      "changes": [
        "+ Đơn vị thiết kế là toàn hệ thống"
      ],
      "metrics": {
        "zoom": "toàn hệ thống",
        "unit": "dịch vụ · kho lưu trữ · hàng đợi",
        "output": "sơ đồ kiến trúc"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Đánh đổi",
      "title": "Quyết định HLD là những đánh đổi",
      "chapter": "tradeoff",
      "body": "Đặt đơn không nên phải chờ tìm được tài xế, nên Đơn hàng **phát một sự kiện** và Tài xế nhận nó khi có thể (xem *Pub/Sub & sự kiện*).\n\nThanh toán cần giao dịch, nên nó có một cơ sở dữ liệu quan hệ. Tài xế gửi vị trí vài giây một lần (hàng chục nghìn lượt ghi mỗi giây, lượt sau ghi đè lượt trước), nên kho đó là một kho key-value nhanh. Mỗi lựa chọn đến từ các con số và từ những gì dữ liệu cần.",
      "callout": {
        "kind": "insight",
        "text": "Mỗi mũi tên và mỗi kho trên sơ đồ HLD là một quyết định có phương án khác. Hãy sẵn sàng nói bạn đã từ bỏ điều gì."
      },
      "changes": [
        "~ Đơn hàng → Tài xế: một sự kiện, không phải lời gọi",
        "~ Thanh toán: SQL · vị trí: key-value"
      ],
      "metrics": {
        "zoom": "toàn hệ thống",
        "unit": "dịch vụ · kho lưu trữ · hàng đợi",
        "output": "sơ đồ kiến trúc"
      },
