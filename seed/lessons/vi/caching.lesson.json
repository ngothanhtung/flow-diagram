  "steps": [
    {
      "id": "s1",
      "short": "CSDL quá tải",
      "title": "Mọi trang đều đánh vào cơ sở dữ liệu",
      "chapter": "problem",
      "body": "Cửa hàng của bạn đắt khách. Mỗi trang sản phẩm hỏi cơ sở dữ liệu cùng một kiểu thông tin (tên, giá, ảnh) và giờ nó đã bận 92%.\n\nCác lượt đọc xếp hàng và trang chậm tới gần nửa giây ở p95.",
      "callout": {
        "kind": "warning",
        "text": "Cơ sở dữ liệu thường là phần khó mở rộng nhất, vì nó giữ dữ liệu. Hãy bảo vệ nó khỏi những việc không cần thiết."
      },
      "changes": [],
      "metrics": {
        "p95": "450 ms",
        "hitRate": "0%",
        "dbLoad": "92%",
        "fresh": "mới"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Đọc giống nhau",
      "title": "Vẫn mấy thứ đó, lặp đi lặp lại",
      "chapter": "insight",
      "body": "Hãy xem cái gì thực sự được đọc: một nhóm nhỏ sản phẩm phổ biến chiếm phần lớn lưu lượng. Cơ sở dữ liệu tính lại cùng những câu trả lời hàng nghìn lần mỗi phút.\n\nNhững câu trả lời được đọc thường xuyên và hiếm khi đổi là hoàn hảo để giữ ở nơi gần hơn, nhanh hơn.",
      "callout": {
        "kind": "insight",
        "text": "Hầu hết khối lượng công việc thực tế đều lệch như vậy: vài mục nóng và một đuôi dài những mục hiếm khi được đọc."
      },
      "changes": [],
      "metrics": {
        "p95": "450 ms",
        "hitRate": "0%",
        "dbLoad": "92%",
        "fresh": "mới"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Thêm cache",
      "title": "Đặt một cache phía trước",
      "chapter": "solution",
      "body": "Thêm một [[cache]] trong bộ nhớ (như Redis hay Memcached). Server kiểm tra nó trước: một lần **trúng** (hit) trả về trong khoảng một mili giây.\n\nKhi **trượt** (miss, màu hổ phách), server đọc cơ sở dữ liệu, rồi lưu một bản sao vào cache cho lần sau. Đây là mẫu [[cache-aside]].",
      "callout": {
        "kind": "tip",
        "text": "Tra cache là lấy một khóa từ bộ nhớ: không lập kế hoạch truy vấn, không join, không đĩa. Nó thường trả lời nhanh hơn 10–100× so với truy vấn mà nó thay thế."
      },
      "changes": [
        "+ Cache",
        "~ 80% lượt đọc phục vụ từ bộ nhớ",
        "~ CPU CSDL 92% → 25%"
      ],
      "metrics": {
        "p95": "40 ms",
        "hitRate": "80%",
        "dbLoad": "25%",
        "fresh": "mới"
      },
      "overrides": {}
    },
    {
      "id": "s4",
      "short": "Tỉ lệ trúng",
      "title": "Tỉ lệ trúng là tất cả",
      "chapter": "technique",
      "body": "Phần lượt đọc được cache trả lời là [[tỉ lệ trúng]] (hit rate). Vì trượt chậm hơn nhiều, thay đổi nhỏ ở tỉ lệ trúng tạo khác biệt lớn.\n\nĐi từ 80% lên 95% trúng giảm thời gian đọc trung bình hơn một nửa và cắt ba phần tư tải của cơ sở dữ liệu.",
      "callout": {
        "kind": "tip",
        "text": "Nâng tỉ lệ trúng bằng cách cache đúng thứ, cho cache đủ bộ nhớ và giữ các mục đủ lâu để được dùng lại."
      },
      "changes": [
        "~ Tỉ lệ trúng 80% → 95%",
        "~ CPU CSDL 25% → 8%"
      ],
      "metrics": {
        "p95": "25 ms",
        "hitRate": "95%",
        "dbLoad": "8%",
        "fresh": "mới"
      },
      "overrides": {}
    },
    {
      "id": "s5",
      "short": "Dữ liệu cũ",
      "title": "Giá đã đổi. Cache thì không.",
      "chapter": "problem",
      "body": "Một quản trị viên đổi giá từ $20 lên $25. Cơ sở dữ liệu có giá mới, nhưng cache vẫn giữ bản cũ, và đó là thứ người dùng thấy.\n\nCache là bản sao thứ hai của sự thật. Giữ các bản sao đồng bộ là phần khó của caching.",
      "callout": {
        "kind": "warning",
        "text": "“Trong khoa học máy tính chỉ có hai việc khó: vô hiệu hóa cache và đặt tên.” — Phil Karlton"
      },
      "changes": [
        "~ CSDL: giá $20 → $25",
        "- Cache vẫn ghi $20"
      ],
      "metrics": {
        "p95": "25 ms",
        "hitRate": "95%",
        "dbLoad": "8%",
        "fresh": "cũ"
      },
      "overrides": {
        "db-3": {
          "visible": false
        },
        "cache": {
          "visible": false
        },
        "sd-3": {
          "visible": false
        },
        "sc": {
          "visible": false
        }
      }
    },
    {
      "id": "s6",
      "short": "Vô hiệu hóa",
      "title": "Vô hiệu hóa khi ghi, hết hạn bằng TTL",
      "chapter": "solution",
      "body": "Khi dữ liệu đổi, server ghi vào cơ sở dữ liệu *và* xóa bản sao trong cache (vòng đỏ). Lượt đọc tiếp theo trượt và lấy giá trị mới.\n\nNhư một tấm lưới an toàn, mỗi mục còn có [[TTL]] (thời gian sống): dù một lần vô hiệu hóa bị bỏ sót, dữ liệu cũ vẫn biến mất trong vòng một phút.\n\nVì sao xóa thay vì ghi đè bản sao trong cache? Hai lần ghi chạy đua có thể để lại giá trị *cũ hơn* trong cache. Xóa luôn an toàn: lượt đọc sau sẽ nạp lại sự thật.",
      "callout": {
        "kind": "tip",
        "text": "Chọn TTL bằng câu hỏi: cũ đến mức nào thì chấp nhận được? Vài giây cho giá và tồn kho, vài giờ cho mô tả sản phẩm."
      },
      "changes": [
        "+ Lệnh ghi xóa bản sao trong cache",
        "+ TTL: 60 s",
        "~ Người dùng thấy $25"
      ],
      "metrics": {
        "p95": "26 ms",
        "hitRate": "94%",
        "dbLoad": "9%",
        "fresh": "mới"
      },
      "overrides": {
        "db-3": {
          "visible": false
        },
        "cache": {
          "visible": false
