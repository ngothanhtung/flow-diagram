  "steps": [
    {
      "id": "s1",
      "short": "Câu hỏi",
      "title": "Một server có đủ không?",
      "chapter": "problem",
      "body": "Bạn đang thiết kế PhotoShare. Trước khi chọn bất kỳ công nghệ nào, bạn cần hình dung quy mô: một server, hay một trăm?\n\nBạn không cần con số chính xác, chỉ cần đúng **bậc độ lớn**. Tính nhẩm nhanh đưa bạn tới đó trong vài phút.",
      "callout": {
        "kind": "insight",
        "text": "Người phỏng vấn lẫn kiến trúc sư đều bắt đầu ở đây: con số ước lượng trước, rồi mới thiết kế cho vừa."
      },
      "changes": [],
      "metrics": {
        "dau": "10M",
        "avg": "?",
        "peak": "?",
        "servers": "?",
        "storage": "?"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Yêu cầu / s",
      "title": "Người dùng mỗi ngày → yêu cầu mỗi giây",
      "chapter": "technique",
      "body": "Bắt đầu từ điều bạn biết: người dùng và họ thao tác thường xuyên thế nào. 10M người × 20 yêu cầu = 200M yêu cầu mỗi ngày.\n\nMột ngày có 86.400 giây. Làm tròn thành **100.000**: tính nhẩm là để nhanh, không phải để chính xác.",
      "callout": {
        "kind": "tip",
        "text": "Mẹo tiện: 1M yêu cầu mỗi ngày ≈ 12 yêu cầu mỗi giây."
      },
      "changes": [
        "+ Tải trung bình ≈ 2.300 yc/s"
      ],
      "metrics": {
        "dau": "10M",
        "avg": "2.300",
        "peak": "?",
        "servers": "?",
        "storage": "?"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Đỉnh",
      "title": "Lên kế hoạch cho đỉnh, không cho trung bình",
      "chapter": "insight",
      "body": "Lưu lượng không phẳng: người ta lướt web vào buổi tối và quanh các sự kiện lớn. Đỉnh điển hình bằng 2–3 lần trung bình ngày.\n\nĐịnh cỡ cho 3 lần và server đơn độc rõ ràng bị quá tải.",
      "callout": {
        "kind": "warning",
        "text": "Một hệ thống định cỡ theo tải trung bình sẽ sập đúng lúc đông người dùng nhất."
      },
      "changes": [
        "+ Đỉnh ≈ 3 × trung bình ≈ 7.000 yc/s",
        "~ Một server: quá tải"
      ],
      "metrics": {
        "dau": "10M",
        "avg": "2.300",
        "peak": "7.000",
        "servers": "?",
        "storage": "?"
      },
      "overrides": {}
    },
    {
      "id": "s4",
      "short": "Server",
      "title": "Bao nhiêu server?",
      "chapter": "solution",
      "body": "Một bài kiểm thử tải cho thấy một server xử lý khoảng **1.000 yc/s**. Đỉnh là 7.000, nên ta cần 7, cộng dư địa cho đột biến và cho trường hợp một server hỏng.\n\nLấy tròn **10**. Để ý rằng ta dùng một con số đo được, không phải đoán.",
      "callout": {
        "kind": "tip",
        "text": "Chia lưu lượng cho các server này là việc của bộ cân bằng tải: xem Mô-đun 02."
      },
      "changes": [
        "+ Tầng web: 10 server",
        "~ Mỗi server bận ~70% lúc đỉnh"
      ],
      "metrics": {
        "dau": "10M",
        "avg": "2.300",
        "peak": "7.000",
        "servers": "10",
        "storage": "?"
      },
      "overrides": {}
    },
    {
      "id": "s5",
      "short": "Lưu trữ",
      "title": "Cần bao nhiêu lưu trữ?",
      "chapter": "technique",
      "body": "Ảnh là phần lớn nhất: 1M lượt tải lên × 2 MB = **2 TB mỗi ngày**. Trong một năm là ~730 TB.\n\nDữ liệu thường được lưu ba bản để một ổ đĩa hỏng không làm mất gì, nên hãy dự trù khoảng **2 PB** năm đầu. Điều đó loại ngay ý “một server CSDL duy nhất”.",
      "callout": {
        "kind": "insight",
        "text": "Lưu trữ tăng mỗi ngày và không bao giờ về không. Yêu cầu mỗi giây đến rồi đi; byte thì ở lại."
      },
      "changes": [
        "+ Tầng lưu trữ",
        "+ 2 TB/ngày → ~730 TB/năm",
        "~ ×3 bản sao → ~2 PB"
      ],
      "metrics": {
        "dau": "10M",
        "avg": "2.300",
        "peak": "7.000",
        "servers": "10",
        "storage": "730 TB"
      },
      "overrides": {}
    },
    {
      "id": "s6",
      "short": "Băng thông",
      "title": "Cần bao nhiêu mạng?",
      "chapter": "technique",
      "body": "Tải lên là phần nhỏ: 2 TB mỗi ngày chỉ khoảng 20 MB/s đi vào. Xem ảnh là phần lớn: nếu mỗi người xem 100 ảnh mỗi ngày dạng thumbnail 200 KB, sẽ có **200 TB mỗi ngày** đi ra.\n\n200 TB ÷ 100.000 s ≈ 2 GB/s: khoảng 16 Gbit/s trung bình, cao hơn lúc đỉnh. Đó là việc của CDN, không phải của mười web server.",
      "callout": {
        "kind": "insight",
        "text": "Ứng dụng đa phương tiện nặng về đọc thường chạm trần băng thông trước CPU. Hãy ước tính byte đi ra, không chỉ số yêu cầu."
      },
      "changes": [
        "+ CDN phục vụ ảnh",
        "+ Lưu lượng ra ≈ 16 Gbit/s trung bình"
      ],
      "metrics": {
        "dau": "10M",
        "avg": "2.300",
        "peak": "7.000",
        "servers": "10",
        "storage": "730 TB"
      },
      "overrides": {}
    },
    {
      "id": "s7",
      "short": "Kích thước cache",
      "title": "Có vừa bộ nhớ không?",
      "chapter": "technique",
      "body": "Feed liên tục đọc metadata ảnh và hồ sơ người dùng. Một cache có giữ được phần nóng không? Hồ sơ: 10M × 2 KB = 20 GB. Ảnh mới hôm nay: 1M × 1 KB = 1 GB.\n\nKhoảng 21 GB: vừa trong bộ nhớ của một server cache (thêm một cái thứ hai để dự phòng). Không cần kiến trúc gì cầu kỳ.",
      "callout": {
        "kind": "tip",
        "text": "Tính nhẩm nhanh thường bảo “cái này nhỏ hơn bạn nghĩ”. Điều đó cũng giá trị như tìm ra thứ gì đó lớn."
      },
      "changes": [
        "+ Cache: ~21 GB dữ liệu nóng"
      ],
