  "steps": [
    {
      "id": "s1",
      "short": "Có an toàn không?",
      "title": "Thay đổi này có an toàn không?",
      "chapter": "setup",
      "body": "Dịch vụ thanh toán áp dụng mã giảm giá. Nó đọc và ghi cơ sở dữ liệu đơn hàng, trừ tiền thẻ qua một nhà cung cấp thanh toán bên ngoài, và hỏi dịch vụ của nhóm Kho xem hàng còn không.\n\nMột lập trình viên vừa đổi cách làm tròn giảm giá. Trước khi phát hành, nhóm kiểm tra bằng tay: bấm qua vài lượt mua trên máy chủ thử nghiệm, mọi thứ đều có vẻ ổn.",
      "callout": {
        "kind": "insight",
        "text": "Mỗi thay đổi đều kéo theo một câu hỏi: nó còn làm hỏng gì nữa? Test là cách trả lời nhanh, mỗi lần, mà không phải trông vào việc ai đó nhớ cần kiểm tra gì."
      },
      "changes": [],
      "metrics": {
        "feedback": "1 ngày",
        "covers": "những gì ai đó bấm thử",
        "escaped": "thường xuyên"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Bằng tay",
      "title": "Bấm thử lung tung sẽ bỏ sót",
      "chapter": "problem",
      "body": "Không ai thử một giỏ ba món giá 9,99 € với mã giảm 10%. Cách làm tròn mới tính 26,98 € thay vì 26,97 €: thừa một xu trên hàng nghìn đơn trước khi bộ phận hỗ trợ nhận ra.\n\nKiểm tra thủ công thì chậm, nên ít khi làm, và chỉ bao phủ những gì ai đó nghĩ ra để thử. Lỗi do người dùng phát hiện.",
      "callout": {
        "kind": "warning",
        "text": "Lỗi được phát hiện càng muộn càng tốn kém: vài giây trong test, vài giờ khi review, vài ngày trên production, cộng thêm hoàn tiền và niềm tin."
      },
      "changes": [
        "- Lỗi làm tròn đã lên production",
        "- Khách hàng tìm ra, không phải nhóm"
      ],
      "metrics": {
        "feedback": "1 ngày",
        "covers": "những gì ai đó bấm thử",
        "escaped": "thường xuyên"
      },
      "overrides": {
        "svc": {
          "visible": false
        },
        "sd": {
          "visible": false
        },
        "si": {
          "visible": false
        }
      }
    },
    {
      "id": "s3",
      "short": "Unit test",
      "title": "Unit test: một phần, tách riêng",
      "chapter": "solution",
      "body": "Một [[unit test]] gọi một hàm với đầu vào biết trước và kiểm tra đầu ra; ở đây là tổng tiền cho một giỏ hàng và mã. Nó chạy trong vài mili giây, không có cơ sở dữ liệu, không có mạng.\n\nVì quá rẻ, bạn viết hàng nghìn cái, và chúng chạy ở mọi thay đổi. Trường hợp làm tròn trở thành một dòng sẽ thất bại ngay khi ai đó làm hỏng nó lần nữa.",
      "callout": {
        "kind": "tip",
        "text": "Viết test cho một lỗi trước khi sửa: xem nó thất bại, sửa code, xem nó qua. Lỗi đó sẽ không bao giờ lặng lẽ quay lại."
      },
      "changes": [
        "+ Unit test gọi Checkout trực tiếp",
        "- Cơ sở dữ liệu, nhà cung cấp và Kho thật"
      ],
      "metrics": {
        "feedback": "30 s",
        "covers": "chỉ logic",
        "escaped": "ít hơn"
      },
      "overrides": {
        "svc": {
          "emphasis": true
        },
        "db": {
          "visible": false
        },
