      }
    },
    {
      "id": "s4",
      "short": "Test double",
      "title": "Test double thay cho phần còn lại",
      "chapter": "technique",
      "body": "Checkout không chạy được nếu thiếu các phụ thuộc, nên test thay chúng bằng [[test double]]: một cơ sở dữ liệu **fake** sống trong bộ nhớ, một nhà cung cấp **stub** luôn trả lời “đã duyệt”, một **mock** ghi lại xem thẻ có bị trừ tiền đúng một lần không.\n\nVấn đề: double chỉ biết những gì bạn bảo nó. Nếu nhà cung cấp thật đổi tên một trường, mọi unit test vẫn qua.",
      "callout": {
        "kind": "warning",
        "text": "Double làm test nhanh và lặp lại được, nhưng có thể âm thầm lệch khỏi thực tế. Phải có thứ gì đó kiểm thử với hệ thống thật nữa."
      },
      "changes": [
        "+ DB fake, nhà cung cấp stub, Kho stub"
      ],
      "metrics": {
        "feedback": "30 s",
        "covers": "chỉ logic",
        "escaped": "ít hơn"
      },
