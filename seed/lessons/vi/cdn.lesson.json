  "steps": [
    {
      "id": "s1",
      "short": "Ở xa",
      "title": "Người dùng của bạn ở xa",
      "chapter": "problem",
      "body": "Server của bạn ở Virginia. Người dùng ở London chờ khoảng 75 ms mỗi lượt khứ hồi; ở Sydney khoảng 200 ms. Một trang cần nhiều lượt khứ hồi, nên Sydney chờ hơn một giây khá nhiều.\n\nTrong khi đó, mọi bức ảnh cho mọi người dùng trên thế giới đều do một origin đó phục vụ.",
      "callout": {
        "kind": "warning",
        "text": "Bạn không thể tăng tốc ánh sáng. Cách duy nhất để cắt độ trễ do khoảng cách là phục vụ người dùng từ nơi gần hơn."
      },
      "changes": [],
      "metrics": {
        "lon": "80 ms",
        "syd": "210 ms",
        "origin": "9.000 yc/s",
        "hitRate": "0%"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Byte giống nhau",
      "title": "Phần lớn byte giống nhau với mọi người",
      "chapter": "insight",
      "body": "Nhìn vào bên trong một lần tải trang. HTML là riêng từng người, nhưng ảnh, script, stylesheet và video thì **giống hệt** nhau với mọi người dùng.\n\nNhững tệp giống hệt và ít thay đổi là hoàn hảo để cache, ở bất cứ đâu, kể cả xa origin.",
      "callout": {
        "kind": "insight",
        "text": "Tài nguyên tĩnh thường chiếm hơn 90% số byte của một trang."
      },
      "changes": [],
      "metrics": {
        "lon": "80 ms",
        "syd": "210 ms",
        "origin": "9.000 yc/s",
        "hitRate": "0%"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Biên",
      "title": "Đặt bản sao ở biên",
      "chapter": "solution",
      "body": "Một [[CDN]] (mạng phân phối nội dung) chạy [[server biên]] ở hàng trăm thành phố. Trỏ tệp tĩnh của bạn vào đó, và mỗi người dùng được phục vụ bởi biên gần nhất.\n\nGiờ London nhận ảnh trong ~10 ms. Chỉ các lần trượt (hổ phách) mới phải đi tới tận Virginia.",
      "callout": {
        "kind": "tip",
        "text": "Các CDN phổ biến: Cloudflare, Fastly, Akamai, Amazon CloudFront. Bạn thuê biên của họ; bạn không vận hành chúng."
      },
      "changes": [
        "+ Server biên ở London và Sydney",
        "~ 90% yêu cầu được trả lời ở biên",
        "~ Tải origin 9.000 → 900 yc/s"
      ],
      "metrics": {
        "lon": "12 ms",
        "syd": "15 ms",
        "origin": "900 yc/s",
        "hitRate": "90%"
      },
      "overrides": {}
    },
    {
      "id": "s4",
      "short": "Biên nguội",
      "title": "Những yêu cầu đầu tiên đều trượt",
      "chapter": "technique",
      "body": "Biên là cache kiểu [[pull-through]]: chúng bắt đầu trống rỗng. Yêu cầu đầu tiên cho một tệp bị trượt, biên lấy nó từ origin, giữ một bản và phục vụ mọi người sau đó.\n\nBiên London đã nóng; biên Sydney vừa khởi động và vẫn đang nạp, nên người dùng Sydney tạm thời phải trả giá cho quãng đường dài.",
      "callout": {
        "kind": "insight",
        "text": "Đây chính là ý tưởng cache-aside của bài trước, trải rộng khắp hành tinh."
      },
      "changes": [
        "~ Biên Sydney: nguội, đang nạp từ origin",
        "~ Độ trễ Sydney 15 → 95 ms (tạm thời)"
      ],
      "metrics": {
        "lon": "12 ms",
        "syd": "95 ms",
        "origin": "2.400 yc/s",
        "hitRate": "70%"
      },
      "overrides": {
