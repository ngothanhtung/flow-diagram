    {
      "id": "s5",
      "short": "Tệp cũ",
      "title": "Bạn phát hành logo mới. Chẳng ai thấy.",
      "chapter": "problem",
      "body": "Bạn thay `logo.png` trên origin. Nhưng các biên đã cache bản cũ với TTL một ngày, nên người dùng vẫn thấy logo cũ, người ở London, người ở Sydney, suốt nhiều giờ.\n\nBạn có thể purge các biên (CDN hiện đại làm việc đó trong vài giây), nhưng phải có người nhớ làm, mỗi lần, và không lệnh purge nào chạm tới những bản đã lưu trong trình duyệt của người dùng.",
      "callout": {
        "kind": "warning",
        "text": "TTL dài là thứ làm CDN nhanh, và cũng là thứ khiến bản cập nhật chậm xuất hiện."
      },
      "changes": [
        "~ Origin: logo.png mới",
        "- Biên vẫn phục vụ bản cũ"
      ],
      "metrics": {
        "lon": "12 ms",
        "syd": "15 ms",
        "origin": "900 yc/s",
        "hitRate": "90%"
      },
