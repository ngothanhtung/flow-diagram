  "steps": [
    {
      "id": "s1",
      "short": "Hợp đồng",
      "title": "Chương trình cần một hợp đồng",
      "chapter": "setup",
      "body": "Ứng dụng di động của bạn hiển thị một hồ sơ: tên, ảnh đại diện, ba bài đăng gần nhất và số người theo dõi. Dữ liệu nằm trên máy chủ của bạn, nên ứng dụng phải hỏi để lấy.\n\n[[API]] là cách hỏi đã được thỏa thuận: có những địa chỉ nào, gửi gì, và nhận lại gì. Ở đây là JSON qua HTTPS.",
      "callout": {
        "kind": "insight",
        "text": "API là một lời hứa. Khi các ứng dụng đã phụ thuộc vào nó, thay đổi nó mà không làm hỏng chúng là một bài toán thiết kế thực sự."
      },
      "changes": [],
      "metrics": {},
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "REST",
      "title": "REST: tài nguyên và động từ",
      "chapter": "technique",
      "body": "[[REST]] coi dữ liệu là các **tài nguyên** có địa chỉ (`/users/42`, `/users/42/posts`) và dùng các động từ HTTP trên chúng: `GET` để đọc, `POST` để tạo, `PUT`/`PATCH` để cập nhật, `DELETE` để xóa.\n\nNó đơn giản, chạy với mọi công cụ, và phản hồi `GET` có thể được trình duyệt và CDN lưu cache. `GET`, `PUT` và `DELETE` còn là [[idempotent]] (lặp lại không thay đổi gì thêm), trong khi `POST` thì không, điều này quan trọng ngay khi client thử lại.",
      "callout": {
        "kind": "tip",
        "text": "Mã trạng thái cũng mang ý nghĩa: 200 OK, 201 Created, 404 Not Found, 429 Too Many Requests, 500 lỗi máy chủ."
      },
      "changes": [
        "+ Ba endpoint cho màn hình hồ sơ"
      ],
      "metrics": {
        "trips": "3",
        "payload": "48 KB",
        "screenMs": "210 ms",
        "unused": "94%"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Trên 4G",
      "title": "Lắm lời và cồng kềnh trên điện thoại",
      "chapter": "problem",
      "body": "Trên điện thoại, mỗi lượt khứ hồi tốn khoảng 100 ms. Client gọi ba lần lần lượt (thường là buộc phải vậy, vì một lệnh gọi cần id từ câu trả lời trước), nên màn hình phải chờ cả ba nối tiếp nhau.\n\nMỗi endpoint còn trả về *toàn bộ* đối tượng: 48 KB về tới để hiển thị khoảng 3 KB. Đó là [[over-fetching]]; cần nhiều lệnh gọi cho một màn hình là [[under-fetching]].",
