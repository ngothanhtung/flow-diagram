  "steps": [
    {
      "id": "s1",
      "short": "Không có đường vào",
      "title": "Bob đã gửi tin nhắn. Làm sao Alice biết?",
      "chapter": "problem",
      "body": "Tin nhắn của Bob tới máy chủ chat. Điện thoại của Alice nên hiển thị nó ngay lập tức.\n\nNhưng HTTP thuần là yêu cầu → phản hồi: chỉ **client** mới có thể bắt đầu cuộc trò chuyện. Máy chủ không có cách nào gọi tới điện thoại của Alice để nói “bạn có thư”.",
      "callout": {
        "kind": "insight",
        "text": "Điện thoại và trình duyệt nằm sau router gia đình và mạng di động vốn chặn kết nối đến: client phải là bên chủ động kết nối."
      },
      "changes": [],
      "metrics": {
        "delay": "không bao giờ",
        "rpm": "0",
        "conns": "0"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Polling",
      "title": "Polling: hỏi liên tục",
      "chapter": "technique",
      "body": "Cách sửa đơn giản nhất: ứng dụng của Alice hỏi “có gì mới không?” mỗi 2 giây. Hầu hết câu trả lời đều trống (chấm nhạt); thỉnh thoảng có một cái mang tin nhắn (xanh lá).\n\nDễ xây bằng các yêu cầu bình thường, nhưng tin nhắn đến trễ tới 2 giây, và phần lớn yêu cầu bị lãng phí.",
      "callout": {
        "kind": "tip",
        "text": "Polling ổn cho những thứ thay đổi chậm (trạng thái build, trang theo dõi đơn hàng) với khoảng thời gian hợp lý."
      },
      "changes": [
        "+ Alice polling mỗi 2 s"
      ],
      "metrics": {
        "delay": "tới 2 s",
        "rpm": "30",
        "wasted": "95%",
        "conns": "0"
      },
      "overrides": {}
    },
    {
      "id": "s3",
      "short": "Ở quy mô lớn",
      "title": "Polling một triệu điện thoại",
      "chapter": "problem",
      "body": "Giờ hãy nhân lên. Một triệu người dùng, mỗi người hỏi mỗi 2 giây, là nửa triệu yêu cầu mỗi giây, và 95% trong số đó nhận câu trả lời “không có gì mới”.\n\nBạn sẽ trả tiền cho cả đội máy chủ mà việc chính là nói không. Polling nhanh hơn để giảm độ trễ chỉ làm tệ hơn.",
      "callout": {
        "kind": "warning",
        "text": "Polling đánh đổi độ mới với tải: giảm một nửa độ trễ thì gấp đôi số yêu cầu."
      },
      "changes": [
        "~ Người dùng 1 → 1.000.000",
        "~ 500.000 yêu cầu/s, 95% trống"
      ],
      "metrics": {
        "delay": "tới 2 s",
        "rpm": "30",
        "wasted": "95%",
        "conns": "0"
      },
