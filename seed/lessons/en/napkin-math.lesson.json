  "steps": [
    {
      "id": "s1",
      "short": "The question",
      "title": "Will one server do?",
      "chapter": "problem",
      "body": "You’re designing PhotoShare. Before choosing any technology you need a sense of scale: is this one server, or a hundred?\n\nYou don’t need exact numbers — just the right **order of magnitude**. Napkin math gets you there in minutes.",
      "callout": {
        "kind": "insight",
        "text": "Interviewers and architects both start here: rough numbers first, then design to fit them."
      },
      "changes": [],
      "metrics": {
        "dau": "10M",
        "avg": "?",
        "peak": "?",
        "servers": "?",
        "storage": "?"
      },
      "overrides": {}
    },
    {
      "id": "s2",
      "short": "Requests / s",
      "title": "Daily users → requests per second",
      "chapter": "technique",
      "body": "Start from what you know: users and how often they act. 10M users × 20 requests = 200M requests a day.\n\nA day has 86,400 seconds. Round it to **100,000** — napkin math is about being quick, not precise.",
      "callout": {
        "kind": "tip",
        "text": "Handy shortcut: 1M requests per day ≈ 12 requests per second."
      },
      "changes": [
        "+ Average load ≈ 2,300 req/s"
      ],
      "metrics": {
        "dau": "10M",
        "avg": "2,300",
