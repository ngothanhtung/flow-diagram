    {
      "id": "s9",
      "short": "Presence",
      "title": "Presence: who’s online",
      "chapter": "technique",
      "body": "The green dot next to a name needs [[presence]]: each app sends a small heartbeat every 30 seconds, and the server records “last seen”. No heartbeat for a minute means offline.\n\nWith a million users that’s ~33,000 heartbeats a second. Keep presence in a fast store with expiring keys, and only push changes to people who are actually looking at that contact.",
      "callout": {
        "kind": "insight",
        "text": "Presence is approximate by design — a few seconds of delay is fine, and it saves enormous traffic."
      },
      "changes": [
        "+ Heartbeats every 30 s",
        "+ Presence store with expiring keys"
      ],
      "metrics": {
        "delay": "< 30 ms",
        "rpm": "2",
        "wasted": "0%",
        "conns": "1M on 20 servers"
      },
      "overrides": {
        "alice-4": {
          "visible": false
        },
