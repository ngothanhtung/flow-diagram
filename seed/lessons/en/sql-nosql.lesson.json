          "effect": "none",
          "emphasis": true
        },
        "as-5": {
          "emphasis": true
        },
        "ak-2": {
          "emphasis": true
        }
      }
    },
    {
      "id": "s9",
      "short": "Specialists",
      "title": "More specialised stores",
      "chapter": "insight",
      "body": "Search is one example of a store built for one access pattern. There are others, each much better than a general database at its job — and worse at everything else.\n\nReach for them when a workload clearly doesn’t fit, not by default: every extra store is more to run, secure, back up and keep in sync.",
      "callout": {
        "kind": "insight",
        "text": "Most systems run fine on one relational database for years. Add specialists one at a time, for a measured need."
      },
